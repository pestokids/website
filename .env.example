# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values end up in the browser bundle. Everything else is a secret.

# ── Vercel (and .env.local) ────────────────────────────────────────────────
# Dates are YYYY-MM-DD.
NEXT_PUBLIC_BETA_DATE=
NEXT_PUBLIC_ADMISSIONS_CLOSE_DATE=
# E.164 without the leading +, e.g. 1 followed by a 10-digit US number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# "true" only on Production. Turns PostHog and Linkrunner on.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# Required when NEXT_PUBLIC_ANALYTICS_ENABLED=true.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_LINKRUNNER_TOKEN=
# Written to .env.local by `pnpm convex dev`; set by `npx convex deploy` on Vercel.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Vercel build only.
CONVEX_DEPLOY_KEY=

# ── Convex dashboard (environment variables) ───────────────────────────────
# "true" on the prod deployment only. When off, emailStatus is "skipped" and
# nothing is sent; the vars below are then only needed where it's on.
EMAIL_SEND_ENABLED=
RESEND_API_KEY=
# e.g. Pesto <hello@your-verified-domain>
EMAIL_FROM=
# Optional, prod deployment only. When set, each new application's signup is
# also sent to Linkrunner from the server (survives ad blockers). Linkrunner
# doesn't deduplicate web events, so check how it pairs with the browser's signup first.
LINKRUNNER_SERVER_KEY=
# Also set NEXT_PUBLIC_WHATSAPP_NUMBER and NEXT_PUBLIC_BETA_DATE in Convex:
# the confirmation email uses them.
# Optional, prod deployment only. Where the daily digest of yesterday's
# application counts goes (9am Los Angeles time); commas for several. Uses
# RESEND_API_KEY and EMAIL_FROM. Unset: no digest.
DIGEST_EMAIL=

# ── GitHub Actions secrets (+ .env.local for running e2e locally) ──────────
ANTHROPIC_API_KEY=
VERCEL_AUTOMATION_BYPASS_SECRET=
E2E_TELEMETRY_DISABLED=
