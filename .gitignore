# Private, never committed (repo is public). See internal/SPEC.md §2.2
internal/

# Env files (secrets). Only the empty example is committed.
.env*
!.env.example

# OS / editor
.DS_Store

# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Testing
/coverage

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem

# e2e: results, logs and traces are unredacted, never commit them.
# .e2e/cache/ (agent.act replays with fake test data) is committed on purpose.
.e2e/results/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
.e2e/junit.xml
.e2e/summary.md
.e2e/logs/
.e2e/videos/
